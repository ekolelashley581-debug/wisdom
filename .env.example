# Supabase (required for admin auth & live CMS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL (used for sitemap / OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional WhatsApp override for chatbot handoff
NEXT_PUBLIC_WHATSAPP_NUMBER=237673949163

# Demo admin password when Supabase is not configured
ADMIN_DEMO_PASSWORD=wisdom-admin

# OpenRouter (optional — enables AI replies beyond FAQ rules)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

