# Supabase (required for admin auth & live CMS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — needed to invite/add users from Admin → Users
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (used for sitemap / OG / auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional WhatsApp override for chatbot handoff
NEXT_PUBLIC_WHATSAPP_NUMBER=237673949163

# Demo admin password when Supabase is not configured
ADMIN_DEMO_PASSWORD=wisdom-admin

# Comma-separated IPs allowed to open /admin (others get a 404).
# 192.168.x.x only works on your LAN. On Vercel use your public IP from whatismyip.
# Leave empty to allow any IP (login still required).
ADMIN_ALLOWED_IPS=192.168.102.39

# OpenRouter (optional — enables AI replies beyond FAQ rules)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Phase 3 — payment stubs (configure in Admin → Payments)
# Full gateway SDKs (MoMo / Orange / Fapshi) wire here later
